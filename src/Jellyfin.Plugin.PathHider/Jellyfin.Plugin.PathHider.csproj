    <RootNamespace>Jellyfin.Plugin.PathHider</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.PathHider</AssemblyName>
    <Version>1.0.0</Version>
    <Description>Hide configured files and folders from Jellyfin library scans.</Description>
